{
    "layer": "top",
    "position": "top",

    "modules-left": ["cpu", "memory", "custom/spotify"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "backlight", "network", "battery"],

    "cpu": {
        "on-click": "alacritty -e bashtop",
        "interval": 15,
        "format": " {}%",
        "max-length": 10
    },
    "memory": {
        "on-click": "alacritty -e bashtop",
        "interval": 30,
        "format": " {}%",
        "max-length": 10
    },

    "custom/spotify": {
        "exec": "python3.12 $HOME/.config/waybar/scripts/mediaplayer.py --player spotify",
        "format": "{}  ",
        "return-type": "json",
        "on-click": "playerctl --player=spotify play-pause",
        "on-scroll-up": "playerctl --player=spotify next",
        "on-scroll-down": "playerctl --player=spotify previous"
    },

    "clock": {
        "interval": 60,
	      "max-length": 25,
        "format": "{:%H:%M  %d/%m/%Y}",
    },

    "pulseaudio": {
		"tooltip": false,
		"scroll-step": 5,
		"format": "{icon} {volume}%",
		"format-muted": " {volume}%",
		"on-click":"pactl set-sink-mute @DEFAULT_SINK@ toggle",
		"format-icons": {
			"default": ["", "", ""]
		}
	},

    "backlight": {
		"tooltip": false,
		"format": " {}%",
		"interval":1,
        "on-scroll-up": "light -A 5",
		"on-scroll-down": "light -U 5"
	},

	"network": {    
		"tooltip": true,
		"format-wifi": "  {essid}",
		"format-ethernet": "󰈁",
        "tooltip-format": "IP: {ipaddr}",
	},

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon}  {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
}
